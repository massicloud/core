{
  "name": "@massicloud/client",
  "version": "0.4.0",
  "description": "Official JavaScript/TypeScript client for MassiCloud — Algerian sovereign cloud BaaS",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "massicloud",
    "baas",
    "postgres",
    "algeria",
    "supabase-alternative"
  ],
  "author": "Amine Kessar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikaminou/massicloud-js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/ui": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@massicloud/client": "^0.4.0"
  }
}
