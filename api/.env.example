# Server
API_PORT=8080
PUBLIC_HOST=localhost # change to your domain on VPS

# Platform database (metadata: users, projects, stages, instances, ...)
# Local dev via infra/docker-compose.yml platform-db service (port 5433):
DATABASE_URL=postgres://massicloud:massicloudpwd@localhost:5433/massicloud?sslmode=disable

# Kubernetes (tenant provisioning — namespaces, postgres, postgrest)
# Unset in-cluster (the API pod uses its ServiceAccount automatically).
# For local dev, point at a kubeconfig that can reach the cluster (e.g. k3s/k3d):
KUBECONFIG=~/.kube/massicloud-config
DOMAIN_SUFFIX=massicloud.work
STORAGE_CLASS=local-path # k3s default

# Backing-service images for tenant provisioning (all have working defaults)
POSTGRES_IMAGE=postgres:16-alpine
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7-alpine
POSTGREST_IMAGE=postgrest/postgrest:v12.2.3
MYSQL_REST_IMAGE=ghcr.io/mikaminou/massicloud-mysql-rest:0.1.0

# Auth
JWT_SECRET=           # min 32 chars, generate with: openssl rand -hex 32
REGISTER_SECRET=      # secret key required to register new admin users
TOKEN_EXPIRY_HOURS=24 # JWT token expiry in hours

# MinIO (object storage)
MINIO_ENDPOINT=localhost:9000  # use minio:9000 when running inside Docker
MINIO_USER=                    # MINIO_ROOT_USER from infra/.env
MINIO_PASSWORD=                # MINIO_ROOT_PASSWORD from infra/.env
MINIO_USE_SSL=false

# Transactional email (platform password reset) via Resend.
# RESEND_API_KEY is optional — if unset, the API logs a WARN at startup and
# reset emails are not delivered.
RESEND_API_KEY=
EMAIL_FROM="MassiCloud <noreply@massidigits.com>"
PORTAL_URL=https://app.massicloud.work

# Prometheus /metrics listens here (separate from API_PORT; cluster-internal only)
METRICS_PORT=9090
